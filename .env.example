# Canonical local-agent env template. The active file is ~/.arcox/agent.env;
# a repository .env may symlink to that protected file.
EOA_PRIVATE_KEY=
SOLANA_PRIVATE_KEY=
ARCOX_AI_ROUTER_API_KEY=
ARCOX_HERMES_API_KEY=

# Origin publik ARCOX. Vercel mem-proxy /api/*, /v1/*, /mcp, dan
# /.well-known/* ke backend, jadi agent tidak butuh alamat VPS.
ARCOX_API_BASE_URL=https://arcoxdex.vercel.app
ARCOX_API_URL=https://arcoxdex.vercel.app
ARCOX_WEB_URL=https://arcoxdex.vercel.app
ARC_RPC=https://rpc.testnet.arc.network
SOLANA_DEVNET_RPC=https://api.devnet.solana.com

ARCOX_MAX_TX_USDC=10
ARCOX_DAILY_LIMIT_USDC=50
ARCOX_MAX_TX_NATIVE=0.1
